# Copy this file to .env and fill in real values before running.

ENV=development

# Database
DATABASE_URL=sqlite:///./sentiment_app.db

# Security
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=session_token
COOKIE_SECURE=false

# CORS - the origin your frontend is served from
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:3000,http://127.0.0.1:3000

# Model
MODEL_PATH=../model
MAX_BATCH_SIZE=32
MAX_INPUT_LENGTH=2000

# Media upload (photo / short video) limits and OCR language
MAX_IMAGE_BYTES=5242880
MAX_VIDEO_BYTES=20971520
MAX_VIDEO_SECONDS=30
VIDEO_FRAME_SAMPLES=6
OCR_LANG=eng
